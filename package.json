{
  "name": "zhsq-smart-community-demo",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "智慧社区治理平台 - Vue3 + Element Plus + ECharts + Express + SQLite（FTS5/WAL/事务）",
  "scripts": {
    "seed": "node server/seed.js",
    "migrate": "node server/migrate.js",
    "reset": "node server/seed.js --force && node server/migrate.js --force",
    "backup": "node server/backup.js",
    "start": "node server/index.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test:api": "node tests/api-smoke.js",
    "test:sqlite": "node tests/sqlite-check.js",
    "test:security": "node tests/security-check.js",
    "test:audit": "node tests/audit-regression.js",
    "test:p0": "node tests/p0-regression.js",
    "test:p2": "node tests/p2-regression.js",
    "test:v25": "node tests/v25-audit.js",
    "test:v26": "node tests/v26-audit.js",
    "test:party": "node tests/party-count.js",
    "test:history": "node tests/history-content.js",
    "test:richtext": "node tests/richtext-upload.js",
    "test:geo": "node tests/geo-basemap.js",
    "test:geoimport": "node tests/geo-import.js",
    "test:gridperson": "node tests/grid-person.js",
    "test:deploy": "node tests/prod-smoke.js",
    "test:ui": "node tests/ui-smoke.js",
    "test:imports": "node tests/vue-imports.js",
    "test:all": "node tests/rate-guard.js --start && node tests/vue-imports.js && node tests/api-smoke.js && node tests/security-check.js && node tests/sqlite-check.js && node tests/audit-regression.js && node tests/p0-regression.js && node tests/p2-regression.js && node tests/v25-audit.js && node tests/v26-audit.js && node tests/party-count.js && node tests/history-content.js && node tests/richtext-upload.js && node tests/geo-basemap.js && node tests/geo-import.js && node tests/grid-person.js && node tests/ui-smoke.js && node tests/rate-guard.js --end",
    "purge:seed": "node server/purge-seed.js",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^5.4.11"
  }
}
