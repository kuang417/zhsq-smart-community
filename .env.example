# ===== 前端构建变量（Vite 只注入 VITE_ 前缀；本文件可命名为 .env.production） =====
# 前后端同域（Nginx 反代 /api）：留空即可，默认 /api
VITE_API_BASE_URL=/api

# 示意件开关：开发环境默认开启（跳步演示按钮、明确标注的示意抓拍画面），设为 0 关闭。
# 生产构建（vite build）强制关闭，避免示意画面混入真实数据；不提供生产环境开启后门。
VITE_DEMO_MODE=1

# ===== 后端运行时变量：写入 docker compose 读取的 .env，切勿放进前端 env 文件 =====
# Docker Compose 示例见 docker-compose.yml；以下为必填/常用项：
# NODE_ENV=production
# PORT=8081
# ZHSQ_JWT_SECRET=<随机32字节以上字符串>
# ZHSQ_DATA_KEY=<随机32字节以上字符串，用于 AES-256-GCM 字段加密；更换后旧密文不可解，需提前轮换>
# ZHSQ_INDEX_KEY=<随机32字节以上字符串，用于 HMAC 精确匹配索引；更换后需重建 sec_phone/sec_idx>
# ZHSQ_ADMIN_PASSWORD=<首次初始化空业务库时的管理员密码，至少12位；库中不含任何演示账号>
# ZHSQ_ROOT_ORG_CODE=<本级行政区编码，默认 450102>
# ZHSQ_DB_FILE=/app/data/zhsq.db
# ZHSQ_CORS_ORIGINS=https://your-domain.example.com
# ZHSQ_TRUST_PROXY=1                    # 仅在确认前面有可信 Nginx 反代时开启，否则保持关闭
# ZHSQ_RATE_GLOBAL=1200
# ZHSQ_RATE_LOGIN=10
# ZHSQ_RATE_RESIDENT=120
# ZHSQ_EXPORT_MAX_ROWS=50000             # 单次 Excel 导出行数上限，防止全量导出打满内存
# ZHSQ_TLS_CERT=/path/to/fullchain.pem  # 不设置时由 Nginx 终止 TLS
# ZHSQ_TLS_KEY=/path/to/privkey.pem
# ZHSQ_ALLOW_FORCE=1                   # 危险：仅用于灾备重建，允许生产执行 migrate --force

# ===== V2.5 实时通道（SSE）与审计加固 =====
# GET /api/events 走统一 JWT 鉴权，无需额外环境变量；连接上限 / 心跳周期在 server/events.js 内配置。
# deploy/nginx.conf 已对该路径关闭代理缓冲（proxy_buffering off）并放宽读超时，单进程部署即可生效。
# 若改为多实例部署，必须把 server/events.js 换成 Redis Pub/Sub 之类的外部总线，
# 否则跨实例的写操作不会互相推送（前端会自动降级为 30 秒轮询并如实标注连接状态）。
